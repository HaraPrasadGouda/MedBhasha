# MedBhasha Environment Configuration
# Google Gemini API Key for Vernacular Medical Document Extraction & Analysis
GEMINI_API_KEY="your-gemini-api-key-here"
# Optional: override the Gemini model used for extraction/localization.
# GEMINI_MODEL="gemini-3.5-flash-lite"

# Server Configuration
HOST="0.0.0.0"
PORT=8000
ENVIRONMENT="development"

# CORS: comma-separated exact origins allowed to call the API.
# Defaults to the production frontend plus local development ports.
# CORS_ORIGINS="https://med-bhasha.vercel.app,http://localhost:5173,http://127.0.0.1:5173"
# Optional: regex for Vercel preview deployments and any local dev port (used by default).
# CORS_ORIGIN_REGEX="https://med-bhasha[a-z0-9-]*\.vercel\.app|http://(localhost|127\.0\.0\.1):\d+"

